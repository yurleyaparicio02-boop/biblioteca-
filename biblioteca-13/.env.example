DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biblioteca
SECRET_KEY=cambiar_por_token_seguro_de_al_menos_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=dev

# Cloudinary (solo para subir portadas; la BD guarda únicamente la secure_url)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
IMAGEN_LIBRO_PREDETERMINADA=https://res.cloudinary.com/demo/image/upload/w_300,h_450,c_fill/sample.jpg
